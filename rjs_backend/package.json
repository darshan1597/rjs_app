{
  "name": "rjs-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the RJS customer, driver, and admin applications",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "bootstrap:super-admin": "node scripts/bootstrap-super-admin.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "multer": "^2.3.0",
    "otplib": "^13.5.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
