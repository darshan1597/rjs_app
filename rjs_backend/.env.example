NODE_ENV=development
PORT=5000
# Optional trusted reverse-proxy IPs/subnets, comma-separated. Leave blank for direct access.
# Use loopback only when a trusted local proxy sanitizes forwarded headers.
TRUST_PROXY=
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret
ACCESS_TOKEN_TTL=15m
ADMIN_SESSION_TTL_HOURS=12
MFA_ENCRYPTION_KEY=replace_with_32_random_bytes_encoded_as_base64
DEV_FIXED_OTP=123456
LOCAL_RIDE_GST_PERCENT=5
GOOGLE_MAPS_SERVER_API_KEY=replace-with-a-server-restricted-google-maps-key
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_only_in_your_local_env
RAZORPAY_WEBHOOK_SECRET=replace_only_in_your_local_env
SUPER_ADMIN_NAME=Darshan
SUPER_ADMIN_EMAIL=darshanradha1597@gmail.com
SUPER_ADMIN_PASSWORD=replace_only_in_your_local_env
CLIENT_ORIGINS=http://localhost:3000
