# Leave empty for local Vite development; /api is proxied to localhost:5000.
# Set this to the public HTTPS backend URL when building for deployment.
VITE_API_BASE_URL=

# Optional public download link for the customer app.
VITE_CUSTOMER_APP_URL=

# Google Maps JavaScript API browser key, restricted to the deployed website domains.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=

# Optional Google Cloud web map ID for styled/vector maps.
VITE_GOOGLE_MAPS_WEB_MAP_ID=
